# Runtime
PORT=8080

# PostgreSQL
DATABASE_URL=

# Authentication secrets
ACCESS_TOKEN_SECRET=

# Matrix JWT authentication
MATRIX_JWT_SECRET=
MATRIX_JWT_ISSUER=pauzechats
MATRIX_JWT_AUDIENCE=pauzechats-matrix

# Trust the first X-Forwarded-For value from the reverse proxy.
# Keep false unless the deployment proxy is explicitly trusted.
TRUST_PROXY=false
